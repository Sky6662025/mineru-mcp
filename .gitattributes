# 统一文本文件行尾为 LF（避免 Windows/Linux 协作时产生无意义 diff）
* text=auto eol=lf

# 二进制文件：禁止任何行尾转换（转换会损坏文件）
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.woff binary
*.woff2 binary

# 明确标记源码与文档为文本
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
